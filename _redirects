# Permanent (301) moves for character guides renamed on 2026-11-27.
# Edge hosts that read this file (Cloudflare Pages, Netlify) answer the old
# addresses below with a single-hop redirect; the HTML stubs with the same
# names stay in place as a fallback wherever this file is not honoured.
# Targets are extensionless because both hosts strip ".html" from the new
# address, so a ".html" target would cost a second hop.

/spongebob.html   /spongebob-squarepants   301
/spongebob        /spongebob-squarepants   301
/eleven.html      /eleven-stranger-things  301
/eleven           /eleven-stranger-things  301
/elsa.html        /elsa-frozen             301
/elsa             /elsa-frozen             301
/trinity.html     /trinity-the-matrix      301
/trinity          /trinity-the-matrix      301
